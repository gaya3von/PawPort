{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "PawPort (local)",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/server.mjs",
      "cwd": "${workspaceFolder}",
      "runtimeArgs": ["--experimental-strip-types"],
      "console": "internalConsole",
      "skipFiles": ["<node_internals>/**"],
      "serverReadyAction": {
        "pattern": "PawPort is running at (https?://\\S+)",
        "uriFormat": "%s",
        "action": "openExternally"
      }
    }
  ]
}
